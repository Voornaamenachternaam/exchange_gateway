# ENVIRONMENT VARIABLE REFERENCE — NOT A FILE TO COPY.
#
# The deployment contract is that ALL configuration lives INLINE in
# docker-compose.yml under the service's `environment:` block. There is no
# `.env` file and no `env_file:` — do not create one. This file exists only as
# a reference for the meaning of each variable; the authoritative values are
# the ones written in docker-compose.yml.
#
# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# >= 32 characters; must NOT start with "REPLACE_".
GATEWAY_HMAC_SECRET=change-me-32-chars-minimum-000000
# Public EAS/Autodiscover service hostname (e.g. calendar.example.com).
GATEWAY_HOST=mail.example.com
# The mailbox domain users sign in with (the "example.com" in user@example.com).
GATEWAY_MAIL_DOMAIN=example.com

# ---------------------------------------------------------------------------
# Backend (Stalwart over the private bridge network)
# ---------------------------------------------------------------------------
# JMAP and CardDAV bases are derived from the CalDAV base when unset.
GATEWAY_CALDAV_BASE=http://stalwart:8080/dav
GATEWAY_JMAP_BASE=http://stalwart:8080/jmap
GATEWAY_CARDDAV_BASE=http://stalwart:8080/carddav
# Deploy-time JMAP Calendars capability verification: off | warn | enforce.
GATEWAY_CALENDAR_CAPABILITY_CHECK=warn
# Plain HTTP to Stalwart only over the private bridge network.
GATEWAY_ALLOW_INSECURE_HTTP=1

# ---------------------------------------------------------------------------
# Server / binding / logging
# ---------------------------------------------------------------------------
GATEWAY_LOG_LEVEL=info
GATEWAY_BIND=[::]:8134
# Identity advertised to clients (Exchange Server SE / 15.2).
GATEWAY_SERVER_VERSION=15.2.2562.45
GATEWAY_SERVER_EXCHANGE_VERSION=Exchange2016

# ---------------------------------------------------------------------------
# EAS Ping vs. Cloudflare edge timeout (audit P0)
# ---------------------------------------------------------------------------
# Hard cap on the effective EAS Ping hold time. Cloudflare terminates an
# unanswered request at the 125s Proxy Read Timeout (HTTP 524); 80s keeps push
# alive. `CF-RAY` auto-detection also clamps when this is unset.
GATEWAY_MAX_PING_HEARTBEAT=80

# ---------------------------------------------------------------------------
# Rate limiting (keyed by CF-Connecting-IP, then Forwarded / X-Forwarded-For)
# ---------------------------------------------------------------------------
# All traffic arrives from Cloudflare edge / Microsoft datacenter IPs, so size
# for several devices behind one egress IP.
GATEWAY_RATE_LIMIT_ENABLED=1
GATEWAY_RATE_LIMIT_REQUESTS_PER_MINUTE=600
GATEWAY_RATE_LIMIT_MAX_CONCURRENT=2000

# ---------------------------------------------------------------------------
# Auth cache / circuit breaker / probe spacing
# ---------------------------------------------------------------------------
# The per-request Basic-auth probe to Stalwart is protected by a per-user
# circuit breaker: after GATEWAY_AUTH_BACKEND_FAILURE_THRESHOLD consecutive
# backend outages a user's circuit opens for up to
# GATEWAY_AUTH_BACKEND_MAX_BACKOFF_SECS (0 disables the breaker). The breaker
# and rate cap are deliberately per-user, not global.
GATEWAY_AUTH_CACHE_TTL_SECS=300
GATEWAY_AUTH_CACHE_NEGATIVE_TTL_SECS=30
GATEWAY_AUTH_CACHE_MAX_ENTRIES=10000
GATEWAY_AUTH_PROBE_MIN_INTERVAL_MS=1000
GATEWAY_AUTH_BACKEND_FAILURE_THRESHOLD=5
GATEWAY_AUTH_BACKEND_MAX_BACKOFF_SECS=60

# ---------------------------------------------------------------------------
# Mail plumbing (SMTP/IMAP on Stalwart)
# ---------------------------------------------------------------------------
GATEWAY_SMTP_HOST=stalwart
GATEWAY_SMTP_PORT=465
GATEWAY_IMAP_HOST=stalwart
GATEWAY_IMAP_PORT=993
GATEWAY_MAIL_HOST=stalwart

# ---------------------------------------------------------------------------
# JMAP-first calendar / contacts / free-busy
# ---------------------------------------------------------------------------
GATEWAY_PREFER_JMAP_CALENDAR=1
GATEWAY_PREFER_JMAP_CONTACTS=1
GATEWAY_PREFER_CALDAV_FREEBUSY=0
GATEWAY_FORCE_CALDAV_CALENDAR=0
GATEWAY_ROOM_BOOKING_ENABLED=true
# Enforce the EAS Provision PolicyKey on non-Provision commands. Default 0:
# the advertised policy is a no-op, so enforcement only adds client friction.
GATEWAY_EAS_REQUIRE_POLICY_KEY=0

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
GATEWAY_DATABASE_PATH=/var/lib/exchange-gateway/gateway.db
GATEWAY_MAX_ATTACHMENT_BYTES=5242880

# ---------------------------------------------------------------------------
# Surface gating (the two target clients need none of these)
# ---------------------------------------------------------------------------
# MAPI/HTTP + NSPI + OAB are unused by New Outlook / Outlook Android; keep off
# unless a client demands them. EWS stays on (Out-of-Office, some folder ops).
GATEWAY_MAPI_ENABLED=0
GATEWAY_MAPI_HMA_ENABLED=0
GATEWAY_MAPI_ORG=
GATEWAY_MAPI_OIDC_ISSUER=
GATEWAY_MAPI_OIDC_AUDIENCE=
GATEWAY_MAPI_CONTENTS_PAGE_SIZE=256
GATEWAY_MAPI_MAX_CONTENTS_ROWS=100000
GATEWAY_EMAIL_ENABLED=1

# ---------------------------------------------------------------------------
# Stalwart admin account for the full GAL (NSPI + OAB); empty = minimal stub.
# These sit in cleartext in docker-compose.yml — chmod 600 that file, or use
# Docker secrets (AUDIT2.md #22).
# ---------------------------------------------------------------------------
GATEWAY_ADMIN_USERNAME=
GATEWAY_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# S/MIME GAL certificates (optional)
# ---------------------------------------------------------------------------
# PEM/DER X.509 (.pem/.der/.cer/.crt) or certs-only CMS PKCS#7 (.p7b/.p7c)
# imported at startup; readable by UID 10001. Filename stems are the recipient
# email fallback when a certificate carries no rfc822Name/emailAddress.
GATEWAY_SMIME_CERT_STORE_DIR=

# Note: the bind-mount host paths (/armblock/exchange-gateway/{data,certs}) must
# exist and be writable by UID 10001 (the container's `gateway` user).
