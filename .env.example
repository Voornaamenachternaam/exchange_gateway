# Copy to .env and fill in before `docker compose up -d --build`.

# Required
GATEWAY_HMAC_SECRET=change-me-32-chars-minimum-000000
GATEWAY_HOST=mail.example.com
GATEWAY_MAIL_DOMAIN=example.com

# Optional overrides (defaults shown)
#GATEWAY_LOG_LEVEL=info
#GATEWAY_BIND=[::]:8134
#GATEWAY_CALDAV_BASE=http://stalwart:8080/dav
#GATEWAY_JMAP_BASE=http://stalwart:8080/jmap
#GATEWAY_CARDDAV_BASE=http://stalwart:8080/carddav
#GATEWAY_DATABASE_PATH=/var/lib/exchange-gateway/gateway.db
#GATEWAY_MAX_ATTACHMENT_BYTES=5242880
#GATEWAY_ROOM_BOOKING_ENABLED=true
#GATEWAY_AUTH_CACHE_TTL_SECS=300
#GATEWAY_AUTH_CACHE_MAX_ENTRIES=10000
#GATEWAY_SMTP_HOST=stalwart
#GATEWAY_SMTP_PORT=465
#GATEWAY_IMAP_HOST=stalwart
#GATEWAY_IMAP_PORT=993
#GATEWAY_MAIL_HOST=stalwart
# Plain HTTP to Stalwart only over the private bridge network; the public
# surface must be TLS-terminated in front of the gateway.
#GATEWAY_ALLOW_INSECURE_HTTP=1
#GATEWAY_PREFER_JMAP_CALENDAR=1
#GATEWAY_MAPI_ENABLED=1
# Stalwart admin account for the full GAL (NSPI + OAB); leave empty otherwise.
#GATEWAY_ADMIN_USERNAME=
#GATEWAY_ADMIN_PASSWORD=

# Note: the bind-mount host path /armblock/exchange-gateway/data must exist
# and be writable by UID 10001 (the container's `gateway` user).
