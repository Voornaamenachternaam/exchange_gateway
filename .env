# .env
# Stalwart Internal URL (CalDAV/JMAP access within Docker network)
JMAP_URL=http://172.28.0.10:8133

# Timezone
GATEWAY_TZ=Europe/Amsterdam

# Public Hostname
GATEWAY_HOST=exchange.mail.example.com

# Mail Domain (used for email address formatting in calendar items)
MAIL_DOMAIN=example.com

# Worker API Endpoint
CF_D1_API_URL=https://exchange.mail.example.com/api/query

# Shared Secret between container and Cloudflare Worker
GATEWAY_SECRET=<redacted>
