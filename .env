# Stalwart Internal URL
JMAP_URL=http://172.28.0.10:8133

# SMTP URL
SMTP_URL=smtp://172.28.0.10:25

# Timezone
GATEWAY_TZ=Europe/Amsterdam

# Public Hostname
GATEWAY_HOST=exchange.mail.example.com

# Worker API Endpoint
# This now points to the Worker Route we will create
CF_D1_API_URL=https://exchange.mail.example.com/api/query

# Shared Secret (Renamed from CF_D1_AUTH_TOKEN)
# The container sends this to the Worker to prove it is allowed to query the DB
GATEWAY_SECRET=<redacted>
