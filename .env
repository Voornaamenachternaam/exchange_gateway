# Stalwart Internal URL (IP of the stalwart container)
JMAP_URL=http://172.28.0.10:8133

# SMTP URL for sending (ActiveSync SendMail)
# Using port 25 for internal trusted network relay to avoid auth complexity in this step
SMTP_URL=smtp://172.28.0.10:25

# Timezone for Calendar Events
GATEWAY_TZ=Europe/Amsterdam

# Public Hostname
GATEWAY_HOST=exchange.mail.example.com

# Cloudflare Worker API Endpoint (The "API" Route you created)
CF_D1_API_URL=https://exchange.mail.example.com/api/query

# Shared Secret used to authenticate the Container -> Worker connection
GATEWAY_SECRET=<redacted>
