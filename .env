# Stalwart Internal URL (IP of the stalwart container)
JMAP_URL=http://172.28.0.10:8133

# SMTP URL for sending (ActiveSync SendMail)
SMTP_URL=smtp://172.28.0.10:465

# Timezone for Calendar Events
GATEWAY_TZ=Europe/Amsterdam

# Public Hostname for AutoDiscover
GATEWAY_HOST=exchange.mail.example.com

# Cloudflare D1 Credentials
CF_D1_API_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/d1/database/<DB_ID>/query
CF_D1_AUTH_TOKEN=<YOUR_TOKEN>
